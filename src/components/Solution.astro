---
import { Image } from 'astro:assets';
import logoImg from '../assets/logo-otta.svg';
---

<section class="solution" id="points">
  <h2 class="solution__title">
    <span class="solution__line">
      <Image src={logoImg} alt="otta" class="solution__logo" />
      <span class="solution__product"><em><span>見</span><span>守</span><span>り</span></em>スニーカー</span><small>なら</small>
    </span>
    <span class="solution__line">
      <span class="solution__sub">まるっと</span><span class="solution__accent">解決！</span>
    </span>
  </h2>
</section>

<style>
  /* 位置・サイズはカンプ（390px 幅）の実測を cqw で比率指定する */
  .solution {
    container-type: inline-size;
    background-color: var(--c-g-000);
  }

  .solution__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: clamp(1.75rem, 8.2cqw, 4rem) clamp(1.25rem, 6cqw, 3rem);
    font-weight: 400;
    line-height: 1.35;
    color: var(--c-text);
  }

  .solution__line {
    display: flex;
    align-items: baseline;
    white-space: nowrap;
  }

  .solution__logo {
    align-self: center;
    width: clamp(4.25rem, 19.5cqw, 9.5rem);
    height: auto;
    margin-right: 0.15em;
  }

  /* 見守りスニーカー（「見守り」に傍点） */
  .solution__product {
    font-size: clamp(1.375rem, 6.4cqw, 3rem);
    letter-spacing: 0.04em;
    color: #50B295;
  }

  .solution__product em {
    font-style: normal;
  }

  /* 傍点。text-emphasis だと点が小さすぎるので1文字ずつ描く */
  .solution__product em span {
    position: relative;
  }

  .solution__product em span::before {
    content: '';
    position: absolute;
    top: -0.24em;
    left: calc(50% - 0.02em);
    width: 0.17em;
    height: 0.17em;
    border-radius: 50%;
    background-color: currentColor;
    transform: translateX(-50%);
  }

  .solution__line small {
    margin-left: 0.25em;
    font-size: clamp(1rem, 4.2cqw, 2rem);
  }

  /* まるっと解決！ */
  .solution__sub {
    font-size: clamp(1.25rem, 5.6cqw, 2.75rem);
    letter-spacing: 0.04em;
  }

  .solution__accent {
    font-size: clamp(1.75rem, 7.9cqw, 3.75rem);
    letter-spacing: 0.04em;
    color: #FF6161;
  }
</style>
