---
import { Image } from 'astro:assets';
import CampaignBanner from './ui/CampaignBanner.astro';
import { en } from '../lib/en';
import mainImg from '../assets/fv-main.png';
import subImg from '../assets/fv-sub.png';
import item01 from '../assets/fv-items-01.png';
import item02 from '../assets/fv-items-02.png';
import item03 from '../assets/fv-items-03.png';
import item04 from '../assets/fv-items-04.png';
import item05 from '../assets/fv-items-05.png';

/** クッションスニーカーの特徴。上段3つ・下段2つで並べる */
const features = [
  { icon: item01, title: '軽量設計', text: '約250g' },
  { icon: item02, title: '立体クッション', text: 'やさしくフィット' },
  { icon: item03, title: '高いグリップ力', text: '滑りにくく安心' },
  { icon: item04, title: '幅広設計', text: 'ゆったり快適' },
  { icon: item05, title: '通気性に優れた', text: '快適な履き心地' },
];
---

<section class="fv">
  <!-- メインビジュアル（写真の上にコピーを重ねる） -->
  <div class="fv__visual">
    <Image
      src={mainImg}
      alt=""
      class="fv__main"
      format="avif"
      loading="eager"
      widths={[390, 780, 1170]}
      sizes="(min-width: 768px) 768px, 100vw"
    />

    <div class="fv__copy">
      <h1 class="fv__title">高齢者の「歩く」を、<br />やさしく見守る。</h1>
      <p class="fv__lead">軽やかで優しい履き心地。<br />散歩や軽い運動など、<br />毎日の外出をもっと楽しく。</p>
    </div>

    <figure class="fv__sole">
      <figcaption class="fv__sole-label">ハチの巣状のソール</figcaption>
      <Image src={subImg} alt="" class="fv__sole-img" format="avif" />
    </figure>
  </div>

  <!-- クッションスニーカーの特徴 -->
  <div class="fv__features">
    <h2 class="fv__features-title">
      <span class="fv__features-en en">LAZY SHOES</span>
      <span class="fv__features-ja">クッションスニーカーの特徴</span>
    </h2>

    <ul class="fv__feature-list">
      {features.map(item => (
        <li class="fv__feature">
          <Image src={item.icon} alt="" class="fv__feature-icon" format="avif" />
          <p class="fv__feature-title">{item.title}</p>
          <p class="fv__feature-text" set:html={en(item.text)} />
        </li>
      ))}
    </ul>
  </div>

  <!-- 特徴のすぐ下に入れるセクション（導入実績など） -->
  <slot />

  <!-- キャンペーンバナー -->
  <div class="fv__banner">
    <CampaignBanner location="fv" />
  </div>
</section>

<style>
  /* 位置・サイズはカンプ（390px 幅）の実測を cqw で比率指定する。
     PC はコンテナが --max-w で頭打ちになるので、cqw も一緒に止まる */
  .fv {
    container-type: inline-size;
    background-color: var(--c-g-000);
  }

  /* メインビジュアル。固定ヘッダーの下まで写真を敷く */
  .fv__visual {
    position: relative;
  }

  .fv__main {
    display: block;
    width: 100%;
    height: auto;
  }

  /* コピー */
  .fv__copy {
    position: absolute;
    top: clamp(4.5rem, 21.5cqw, 10.5rem);
    left: clamp(1rem, 6.2cqw, 3rem);
    color: var(--c-text);
  }

  .fv__title {
    font-size: clamp(1.375rem, 6.4cqw, 3rem);
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: 0.02em;
  }

  .fv__lead {
    margin-top: clamp(0.375rem, 2cqw, 1rem);
    /* カンプは約 14px だが、本文の下限 --fs-m に合わせる */
    font-size: clamp(1rem, 4.1cqw, 1.5rem);
    font-weight: 500;
    line-height: 1.65;
    letter-spacing: 0.02em;
  }

  /* ハチの巣状のソール */
  .fv__sole {
    position: absolute;
    top: clamp(12rem, 66.5cqw, 32.5rem);
    left: clamp(1rem, 5.6cqw, 2.75rem);
    width: clamp(7.5rem, 32.6cqw, 15.5rem);
    margin: 0;
  }

  .fv__sole-label {
    position: relative;
    z-index: 1;
    width: max-content;
    padding: 0.35em 1.1em;
    border-radius: 9999px;
    background-color: var(--c-dark);
    color: var(--c-g-000);
    font-size: clamp(0.75rem, 3.2cqw, 1.375rem);
    font-weight: 500;
    line-height: 1.5;
  }

  .fv__sole-img {
    display: block;
    width: 100%;
    height: auto;
    margin-top: -0.75em;
    border-radius: 50%;
  }

  /* PC は固定ヘッダーが無い（左のナビに移る）ので、その分上に詰める */
  @media (min-width: 1400px) {
    .fv__copy {
      top: clamp(2.5rem, 7cqw, 3.5rem);
    }

    .fv__sole {
      top: clamp(20rem, 48cqw, 23.5rem);
    }
  }

  /* 特徴の見出し帯 */
  .fv__features-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25em;
    padding-block: clamp(1rem, 4.6cqw, 2rem);
    background-color: var(--c-dark);
    color: var(--c-g-000);
    text-align: center;
  }

  .fv__features-en {
    font-size: clamp(1.5rem, 7.2cqw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.08em;
  }

  .fv__features-ja {
    font-size: clamp(1.125rem, 5.1cqw, 2rem);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.04em;
  }

  /* 特徴の一覧（上段3・下段2）。罫線はセル同士の隙間で引く */
  .fv__feature-list {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 2px;
    background-color: var(--c-dark);
    border-bottom: 2px solid var(--c-dark);
  }

  .fv__feature {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: clamp(1rem, 4.6cqw, 2rem);
    background-color: var(--c-g-000);
    color: var(--c-dark);
    text-align: center;
  }

  .fv__feature:nth-child(n + 4) {
    grid-column: span 3;
  }

  .fv__feature-icon {
    width: clamp(2.5rem, 13cqw, 4.5rem);
    height: auto;
    margin-bottom: clamp(0.5rem, 2.6cqw, 1rem);
  }

  .fv__feature-title {
    font-size: clamp(0.8125rem, 3.5cqw, 1.25rem);
    font-weight: 700;
    line-height: 1.5;
    white-space: nowrap;
  }

  .fv__feature-text {
    font-size: clamp(0.8125rem, 3.5cqw, 1.25rem);
    line-height: 1.5;
    white-space: nowrap;
  }

  /* キャンペーンバナー */
  .fv__banner {
    position: relative;
    background-color: var(--c-g-000);
    padding-top: clamp(1.5rem, 10.3vw, 5rem);
  }
</style>
