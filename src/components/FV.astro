---
import { Image } from 'astro:assets';
import { en } from '../lib/en';
import mainImg from '../assets/fv-main.png';
import subImg from '../assets/fv-sub.png';
import appImg from '../assets/fv_img.png';
import item01 from '../assets/fv-items-01.png';
import item02 from '../assets/fv-items-02.png';
import item03 from '../assets/fv-items-03.png';
import item04 from '../assets/fv-items-04.png';
import item05 from '../assets/fv-items-05.png';

/** クッションスニーカーの特徴。上段3つ・下段2つで並べる */
const features = [
  { icon: item01, title: '軽量設計', text: '約250g' },
  { icon: item02, title: '立体クッション', text: 'やさしくフィット' },
  { icon: item03, title: '高いグリップ力', text: '滑りにくく安心' },
  { icon: item04, title: '幅広設計', text: 'ゆったり快適' },
  { icon: item05, title: '通気性に優れた', text: '快適な履き心地' },
];
---

<section class="fv">
  <!-- メインビジュアル（写真の上にコピーを重ねる） -->
  <div class="fv__visual">
    <Image
      src={mainImg}
      alt=""
      class="fv__main"
      format="avif"
      loading="eager"
      widths={[390, 780]}
      sizes="(min-width: 768px) 768px, 100vw"
    />

    <div class="fv__copy">
      <h1 class="fv__title">歩く安心も<br />見守る安心も、<br />この一足に。</h1>
      <p class="fv__lead">見守り機能を搭載した<br />やさしい履き心地の<br />スニーカーです。</p>
    </div>

    <!-- 見守りアプリの画面（「見守り機能を靴に搭載」の文字は画像に含まれる） -->
    <Image
      src={subImg}
      alt="見守り機能を靴に搭載。見守りアプリの地図で位置を確認できます"
      class="fv__sub"
      format="avif"
      loading="eager"
      widths={[160, 320, 483]}
      sizes="(min-width: 768px) 313px, 41vw"
    />
  </div>

  <!-- 見守り機能の紹介（靴の紹介より先に「見守りの商品」であることを伝える） -->
  <div class="fv__intro">
    <div class="fv__intro-body">
      <h2 class="fv__intro-title">履くだけで、居場所がわかる。</h2>
      <p class="fv__intro-text" set:html={en('靴底に見守り端末を内蔵した、ottaの見守りスニーカー。履いて歩くだけで、立ち寄った場所の記録がご家族のスマホに届きます。端末を持ち歩く必要も、充電する手間もありません。毎日の「いってきます」が、そのまま見守りになります。')} />
    </div>
    <Image
      src={appImg}
      alt="見守りアプリの画面を手に持ったスマホ。地図上に立ち寄った場所と時刻が表示されています"
      class="fv__intro-img"
      format="avif"
      widths={[202, 404, 422]}
      sizes="(min-width: 769px) 262px, 52vw"
    />
  </div>

  <!-- クッションスニーカーの特徴 -->
  <div class="fv__features" id="features">
    <h2 class="fv__features-title">
      <span class="fv__features-en en">LAZY SHOES</span>
      <span class="fv__features-ja">クッションスニーカーの特徴</span>
    </h2>

    <ul class="fv__feature-list">
      {features.map(item => (
        <li class="fv__feature">
          <Image src={item.icon} alt="" class="fv__feature-icon" format="avif" />
          <p class="fv__feature-title">{item.title}</p>
          <p class="fv__feature-text" set:html={en(item.text)} />
        </li>
      ))}
    </ul>
  </div>

</section>

<style>
  /* 位置・サイズはカンプ（390px 幅）の実測を cqw で比率指定する。
     PC はコンテナが --max-w で頭打ちになるので、cqw も一緒に止まる */
  .fv {
    container-type: inline-size;
    background-color: var(--c-g-000);
  }

  /* メインビジュアル。固定ヘッダーの下まで写真を敷く */
  .fv__visual {
    position: relative;
  }

  .fv__main {
    display: block;
    width: 100%;
    height: auto;
  }

  /* コピー */
  .fv__copy {
    position: absolute;
    top: clamp(4.5rem, 30cqw, 14.5rem);
    left: clamp(1rem, 6.2cqw, 3rem);
    color: var(--c-text);
  }

  .fv__title {
    font-size: clamp(1.375rem, 6.4cqw, 3rem);
    font-weight: 700;
    line-height: 1.54;
    letter-spacing: 0.02em;
  }

  .fv__lead {
    margin-top: clamp(0.5rem, 2.6cqw, 1.25rem);
    /* 本文の下限は --fs-m だが、16px だと右のアプリ画面に重なるため
       カンプ（約 13px）に近い 14px に留める */
    font-size: clamp(0.875rem, 3.6cqw, 1.5rem);
    font-weight: 500;
    line-height: 1.8;
    letter-spacing: 0.02em;
  }

  /* 見守りアプリの画面（右上） */
  .fv__sub {
    position: absolute;
    top: clamp(4.5rem, 32cqw, 15.5rem);
    left: 58.5%;
    width: 40.8%;
    height: auto;
  }

  /* PC は固定ヘッダーが無い（左のナビに移る）ので、その分上に詰める */
  @media (min-width: 1400px) {
    .fv__copy {
      top: clamp(5rem, 12cqw, 6rem);
    }

    .fv__sub {
      top: clamp(4.5rem, 11cqw, 5.5rem);
    }

    /* PC は縦に余裕があるので、余白・行間を広めに取る */
    .fv__lead {
      margin-top: clamp(0.75rem, 3.6cqw, 1.75rem);
      line-height: 1.85;
    }
  }

  /* 見守り機能の紹介 */
  .fv__intro {
    display: flex;
    flex-direction: column;
    padding: var(--section-pt) clamp(1rem, 6.2cqw, 3rem) 0;
    color: var(--c-text);
  }

  .fv__intro-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.02em;
  }

  .fv__intro-text {
    margin-top: var(--content-gap);
    font-size: var(--fs-m);
    line-height: 1.85;
    letter-spacing: 0.02em;
    text-wrap: pretty;
  }

  /* スマホの画像は下の紺の帯にぴったり付ける */
  .fv__intro-img {
    align-self: center;
    /* カンプ実測 202px / 390px 幅。cqw はセクション全幅基準なので余白に左右されない */
    width: 51.8cqw;
    height: auto;
    margin-top: var(--content-gap);
  }

  /* 列が広い幅では、文章を左・スマホを右に並べる */
  @media (min-width: 769px) {
    .fv__intro {
      flex-direction: row;
      align-items: center;
      gap: clamp(1.5rem, 5cqw, 3rem);
    }

    /* 2カラムだと文章の幅が狭くなるので、見出しが1行に収まる大きさにする */
    .fv__intro-title {
      font-size: clamp(1.375rem, 3.2cqw, 1.625rem);
    }

    .fv__intro-body {
      flex: 1;
      /* 画像は下端を帯に付けるので、その分だけ文章を上に寄せる */
      padding-bottom: var(--content-gap);
    }

    .fv__intro-img {
      flex-shrink: 0;
      align-self: flex-end;
      width: 34cqw;
      margin-top: 0;
    }
  }

  /* 特徴の見出し帯 */
  .fv__features-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25em;
    padding-block: clamp(1rem, 4.6cqw, 2rem);
    background-color: var(--c-dark);
    color: var(--c-g-000);
    text-align: center;
  }

  .fv__features-en {
    font-size: clamp(1.5rem, 7.2cqw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.08em;
  }

  .fv__features-ja {
    font-size: clamp(1.125rem, 5.1cqw, 2rem);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.04em;
  }

  /* 特徴の一覧（上段3・下段2）。罫線はセル同士の隙間で引く */
  .fv__feature-list {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 2px;
    background-color: var(--c-dark);
    border-bottom: 2px solid var(--c-dark);
  }

  .fv__feature {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: clamp(1rem, 4.6cqw, 2rem);
    background-color: var(--c-g-000);
    color: var(--c-dark);
    text-align: center;
  }

  .fv__feature:nth-child(n + 4) {
    grid-column: span 3;
  }

  .fv__feature-icon {
    width: clamp(2.5rem, 13cqw, 4.5rem);
    height: auto;
    margin-bottom: clamp(0.5rem, 2.6cqw, 1rem);
  }

  .fv__feature-title {
    font-size: clamp(0.8125rem, 3.5cqw, 1.25rem);
    font-weight: 700;
    line-height: 1.5;
    white-space: nowrap;
  }

  .fv__feature-text {
    font-size: clamp(0.8125rem, 3.5cqw, 1.25rem);
    line-height: 1.5;
    white-space: nowrap;
  }
</style>
