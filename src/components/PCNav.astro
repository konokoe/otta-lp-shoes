---
import { Image } from 'astro:assets';
import logoSrc from '../assets/logo.svg';
import ArrowIcon from './icon/ArrowIcon.astro';
import { LINE_URL } from '../lib/links';
import { en } from '../lib/en';
import { NAV_ITEMS } from '../lib/nav';

const navItems = NAV_ITEMS;
---

<nav class="pc-nav">
  <div class="pc-nav__logo-wrap">
    <Image src={logoSrc} alt="otta" class="pc-nav__logo" />
  </div>

  <div class="pc-nav__ctas">
    <a
      href={LINE_URL}
      class="pc-nav__cta"
      target={LINE_URL.startsWith('http') ? '_blank' : undefined}
      rel={LINE_URL.startsWith('http') ? 'noopener noreferrer' : undefined}
    >
      <span><span class="en">LINE</span>登録はこちら</span>
      <span class="pc-nav__cta-arrow"><ArrowIcon fill="#00D053" size={7} /></span>
    </a>
  </div>

  <ul class="pc-nav__list">
    {navItems.map(item => (
      <li>
        <a
          href={item.href}
          class="pc-nav__item js-nav"
          data-nav-label={item.label}
          data-nav-target={item.href}
          data-nav-location="pc-nav"
        >
          <span set:html={en(item.label)}></span>
          <ArrowIcon fill="#AFA99C" size={5} rotate={90} />
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .pc-nav {
    display: none;
  }

  @media (min-width: 1400px) {
    .pc-nav {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      position: fixed;
      top: clamp(3.5rem, 12vw, 4.5rem);
      /* 中央 768px のコンテンツ両脇に空く余白 */
      --gutter: calc(50vw - 384px);
      /* 余白いっぱいには広げず上限を設け、残りを均等に振って余白内で中央に置く。
         比率だけで決めると 1400px 付近でナビが細くなりすぎ、CTAの文言が折り返す */
      --nav-w: min(calc(var(--gutter) - 3rem), 20rem);
      left: calc((var(--gutter) - var(--nav-w)) / 2);
      width: var(--nav-w);
      background-color: var(--c-g-000);
      padding: clamp(0.875rem, 1.4vw, 1.5rem);
      border-radius: 1rem;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1);
    }

    .pc-nav__logo-wrap {
      display: flex;
      justify-content: center;
      padding-block: 0.75rem;
    }

    .pc-nav__logo {
      width: 70%;
      max-width: 200px;
      height: auto;
    }

    .pc-nav__ctas {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    /* LINE 登録ボタン（LINE のブランドカラー） */
    .pc-nav__cta {
      --c-line: #00D053;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: var(--c-g-000);
      color: var(--c-line);
      border: 0.1875rem solid var(--c-line);
      font-size: clamp(0.9375rem, 1.1vw, 1.0625rem);
      font-weight: 700;
      /* 右パディングは矢印アイコンの居場所。文言と重ならないよう広めに取る */
      padding: 0.875rem 1.5rem;
      white-space: nowrap;
      border-radius: 0.5rem;
      transition: background-color 0.25s, color 0.25s, box-shadow 0.25s, transform 0.25s;
      position: relative;
      text-align: center;
    }

    .pc-nav__cta:hover {
      background-color: var(--c-line);
      color: var(--c-g-000);
      box-shadow: 0 4px 16px rgba(0, 208, 83, 0.35);
      transform: translateY(-1px);
    }

    .pc-nav__cta:hover :global(path) {
      fill: var(--c-g-000);
    }

    .pc-nav__cta:focus-visible {
      outline: 2.5px solid var(--c-line);
      outline-offset: 3px;
    }

    .pc-nav__cta-arrow {
      position: absolute;
      right: 0.75rem;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      align-items: center;
    }

    .pc-nav__list {
      display: flex;
      flex-direction: column;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .pc-nav__item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 0.5rem;
      margin-inline: -0.5rem;
      font-size: var(--fs-s);
      font-weight: 400;
      color: var(--c-text);
      border-bottom: 1px solid var(--c-g-300);
      transition: background-color 0.2s, color 0.2s, padding-left 0.2s;
    }

    .pc-nav__item:hover {
      background-color: var(--c-g-200);
      color: var(--c-text);
      padding-left: 1rem;
    }

    .pc-nav__item:hover :global(svg) {
      animation: arrowBounce 0.4s ease forwards;
    }

    .pc-nav__item:focus-visible {
      outline: 2.5px solid var(--c-green);
      outline-offset: 2px;
    }

    li:last-child .pc-nav__item {
      border-bottom: none;
    }

    .pc-nav__item :global(svg) {
      flex-shrink: 0;
    }

    @keyframes arrowBounce {
      0%   { transform: rotate(90deg) translateX(0); }
      40%  { transform: rotate(90deg) translateX(3px); }
      70%  { transform: rotate(90deg) translateX(-1px); }
      100% { transform: rotate(90deg) translateX(0); }
    }
  }
</style>
