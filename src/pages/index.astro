---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import FV from '../components/FV.astro';
import Adoption from '../components/Adoption.astro';
import LineCta from '../components/LineCta.astro';
import Problem from '../components/Problem.astro';
import Solution from '../components/Solution.astro';
import ShoePoints from '../components/ShoePoints.astro';
import Service from '../components/Service.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="歩く安心も見守る安心も、この一足に。見守りスニーカー｜otta" description="履くだけで見守れる、高齢者向けの見守りスニーカー「otta」。見守り端末を靴底に内蔵しているので置き忘れがなく、充電不要で最長5年使えます。水洗いもOK。全国18万箇所の見守りスポットが位置情報を記録します。2026年冬頃販売開始予定。LINE登録で最新情報をお届けします。">
  <Header />
  <main>
    <FV />
    <Adoption />
    <LineCta id="release" />
    <Problem />
    <Solution />
    <ShoePoints />
    <Service />
    <LineCta />
  </main>
  <Footer />
</BaseLayout>
